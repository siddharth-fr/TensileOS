# TensileOS Git Ignore Configuration

# ==========================================
# Persistent Context Memory (Rule 3)
# ==========================================
context_memory.md
context_memory.md.bak

# ==========================================
# Secrets, Wi-Fi Credentials & Private Configs
# ==========================================
secrets.h
config_private.h
*.env
*.env.local
*.pem
*.key
*.cert

# ==========================================
# Arduino & Arduino-CLI Build Artifacts
# ==========================================
build/
build-*/
*.bin
*.elf
*.hex
*.map
*.o
*.d
*.a
*.dump

# ==========================================
# PlatformIO Environment & Build Dirs
# ==========================================
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

# ==========================================
# IDE & Editor Local Workspaces
# ==========================================
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.user
*.workspace
*.sublime-project
*.sublime-workspace

# ==========================================
# Python & Tooling Caches
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ==========================================
# OS-Specific Metadata Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ==========================================
# Temporary Files, Dumps & Logs
# ==========================================
*.log
*.tmp
*.bak
*.swp
*~
